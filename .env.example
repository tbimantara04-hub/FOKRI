# Public frontend variables
VITE_APP_NAME=FOKRI GAMES XII
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Legacy compatibility names (keep only if required by older local tooling)
# VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-side secrets (must be kept out of Git and set in Vercel / .env.local)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-server-only-token

# App config
APP_ENV=development
SESSION_SECRET=replace-with-strong-random-secret

# Optional storage / email provider config
STORAGE_BUCKET=participant-documents
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@fokri.games

# NOTE: Never place secrets inside VITE_* variables.
# SUPABASE_JWT_SECRET must never be added to frontend code.
